{
  "id": "chat",
  "name": "AI Chat",
  "description": "Chat with an AI agent that writes code, searches the web, and runs commands in a sandbox.",
  "scope": {
    "allowed": [
      "chat",
      "code-execution",
      "web-search",
      "file-analysis",
      "multi-step-tasks",
      "plan"
    ],
    "forbidden": [
      "local-shell",
      "file-system-access",
      "infinite-autonomous-loop",
      "unauthorized-commands"
    ]
  },
  "stack": {
    "framework": "nextjs-14",
    "styling": "tailwind",
    "components": "shadcn",
    "icons": "lucide-react"
  },
  "constraints": {
    "maxAttachmentSizeMb": 25,
    "maxAttachments": 10,
    "maxMessagesInContext": 50,
    "codeOnlyInSandbox": true,
    "allowInlineStyles": false,
    "allowClientEnv": false,
    "componentStyle": "functional",
    "typescriptStrict": true,
    "allowedDependencies": [
      "react",
      "react-dom",
      "next",
      "lucide-react",
      "@supabase/supabase-js"
    ],
    "forbiddenDependencies": [
      "jquery",
      "axios",
      "lodash",
      "moment",
      "child_process"
    ]
  }
}
