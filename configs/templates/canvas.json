{
  "id": "canvas",
  "name": "AI Canvas",
  "description": "Freeform visual workspace for images and videos with region editing and motion control.",
  "scope": {
    "allowed": [
      "freeform-workspace",
      "image-upload",
      "image-generation",
      "arrange",
      "region-edit",
      "motion-control"
    ],
    "forbidden": [
      "copyright-infringement",
      "auto-public-share",
      "more-than-50-layers"
    ]
  },
  "stack": {
    "framework": "nextjs-14",
    "styling": "tailwind",
    "components": "shadcn",
    "icons": "lucide-react"
  },
  "constraints": {
    "maxCanvasSize": 4096,
    "maxLayers": 50,
    "autoSaveIntervalSeconds": 30,
    "allowInlineStyles": false,
    "allowClientEnv": false,
    "componentStyle": "functional",
    "typescriptStrict": true,
    "allowedDependencies": [
      "react",
      "react-dom",
      "next",
      "lucide-react",
      "@supabase/supabase-js"
    ],
    "forbiddenDependencies": [
      "jquery",
      "axios",
      "lodash",
      "moment"
    ]
  }
}
