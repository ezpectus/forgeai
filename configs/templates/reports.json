{
  "id": "reports",
  "name": "AI Reports",
  "description": "Generate research-grade reports with citations, charts, and structured analysis.",
  "scope": {
    "allowed": [
      "research-report",
      "executive-summary",
      "competitive-analysis",
      "swot",
      "market-sizing"
    ],
    "forbidden": [
      "plagiarism",
      "fabricated-citations",
      "long-form-above-50-pages",
      "unsourced-claims"
    ]
  },
  "stack": {
    "framework": "nextjs-14",
    "styling": "tailwind",
    "components": "shadcn",
    "icons": "lucide-react"
  },
  "constraints": {
    "maxPages": 50,
    "maxSections": 12,
    "requiredStructure": [
      "Title",
      "Summary",
      "Introduction",
      "Body",
      "Conclusion",
      "Sources"
    ],
    "requireCitationsFor": [
      "statistics",
      "quotes",
      "competitor-data",
      "market-size"
    ],
    "allowInlineStyles": false,
    "allowClientEnv": false,
    "componentStyle": "functional",
    "typescriptStrict": true,
    "allowedDependencies": [
      "react",
      "react-dom",
      "next",
      "lucide-react",
      "@supabase/supabase-js"
    ],
    "forbiddenDependencies": [
      "jquery",
      "axios",
      "lodash",
      "moment"
    ]
  }
}
