{
  "id": "carousel",
  "name": "AI Carousel",
  "description": "Generate multi-slide social media carousel posts for Instagram, LinkedIn, and X.",
  "scope": {
    "allowed": [
      "instagram",
      "linkedin",
      "twitter",
      "social-posts",
      "brand-consistent"
    ],
    "forbidden": [
      "animated-carousels",
      "video-in-carousel",
      "more-than-15-slides"
    ]
  },
  "stack": {
    "framework": "nextjs-14",
    "styling": "tailwind",
    "components": "shadcn",
    "icons": "lucide-react"
  },
  "constraints": {
    "minSlides": 3,
    "maxSlides": 15,
    "allowedAspectRatios": [
      "1:1",
      "4:5",
      "16:9"
    ],
    "maxColorsInPalette": 3,
    "maxFontsPerCarousel": 2,
    "allowInlineStyles": false,
    "allowClientEnv": false,
    "componentStyle": "functional",
    "typescriptStrict": true,
    "allowedDependencies": [
      "react",
      "react-dom",
      "next",
      "lucide-react",
      "@supabase/supabase-js"
    ],
    "forbiddenDependencies": [
      "jquery",
      "axios",
      "lodash",
      "moment"
    ]
  }
}
