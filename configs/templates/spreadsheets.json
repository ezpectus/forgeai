{
  "id": "spreadsheets",
  "name": "AI Spreadsheets",
  "description": "Generate spreadsheets with formulas, charts, and XLSX/CSV import-export.",
  "scope": {
    "allowed": [
      "cash-flow",
      "budget",
      "tracker",
      "formulas",
      "charts",
      "xlsx-export",
      "csv-export"
    ],
    "forbidden": [
      "sql-queries",
      "macros",
      "vba",
      "real-time-collab"
    ]
  },
  "stack": {
    "framework": "nextjs-14",
    "styling": "tailwind",
    "components": "shadcn",
    "icons": "lucide-react"
  },
  "constraints": {
    "maxRows": 1000,
    "maxCols": 50,
    "allowedFormulas": [
      "SUM",
      "AVERAGE",
      "IF",
      "VLOOKUP",
      "COUNT",
      "MAX",
      "MIN",
      "ROUND",
      "TODAY"
    ],
    "allowedChartTypes": [
      "line",
      "bar",
      "pie",
      "doughnut"
    ],
    "noCircularReferences": true,
    "allowInlineStyles": false,
    "allowClientEnv": false,
    "componentStyle": "functional",
    "typescriptStrict": true,
    "allowedDependencies": [
      "react",
      "react-dom",
      "next",
      "lucide-react",
      "@supabase/supabase-js"
    ],
    "forbiddenDependencies": [
      "jquery",
      "axios",
      "lodash",
      "moment"
    ]
  }
}
