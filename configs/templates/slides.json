{
  "id": "slides",
  "name": "AI Slides",
  "description": "Generate professional presentations with inline editing and PDF/PPTX export.",
  "scope": {
    "allowed": [
      "pitch-deck",
      "sales-presentation",
      "educational",
      "report-slides",
      "charts"
    ],
    "forbidden": [
      "games",
      "interactive-apps",
      "video",
      "real-time-collab",
      "websites"
    ]
  },
  "stack": {
    "framework": "nextjs-14",
    "styling": "tailwind",
    "components": "shadcn",
    "icons": "lucide-react",
    "animation": "css"
  },
  "constraints": {
    "maxSlides": 15,
    "maxElementsPerSlide": 6,
    "maxPages": 1,
    "maxSectionsPerPage": 1,
    "allowInlineStyles": false,
    "allowClientEnv": false,
    "componentStyle": "functional",
    "typescriptStrict": true,
    "font": "Inter",
    "maxColorsInPalette": 4,
    "allowedDependencies": [
      "react",
      "react-dom",
      "next",
      "lucide-react",
      "@supabase/supabase-js"
    ],
    "forbiddenDependencies": [
      "jquery",
      "axios",
      "lodash",
      "moment",
      "styled-components",
      "@emotion/react",
      "gsap",
      "framer-motion"
    ]
  }
}
