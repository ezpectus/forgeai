{
  "id": "audio",
  "name": "AI Audio",
  "description": "Text-to-speech, music generation, voice cloning, sound effects, dubbing, and transcription.",
  "scope": {
    "allowed": [
      "text-to-speech",
      "music",
      "voice-cloning",
      "sound-effects",
      "dubbing",
      "transcription"
    ],
    "forbidden": [
      "voice-cloning-without-consent",
      "nsfw-audio",
      "live-streaming-podcast"
    ]
  },
  "stack": {
    "framework": "nextjs-14",
    "styling": "tailwind",
    "components": "shadcn",
    "icons": "lucide-react"
  },
  "constraints": {
    "maxAudioDurationSeconds": 600,
    "maxTTSDurationSeconds": 600,
    "maxMusicDurationSeconds": 300,
    "maxTranscriptionFileSizeMb": 100,
    "voiceCloningRequiresConsent": true,
    "allowedFormats": [
      "mp3",
      "wav"
    ],
    "allowInlineStyles": false,
    "allowClientEnv": false,
    "componentStyle": "functional",
    "typescriptStrict": true,
    "allowedDependencies": [
      "react",
      "react-dom",
      "next",
      "lucide-react",
      "@supabase/supabase-js"
    ],
    "forbiddenDependencies": [
      "jquery",
      "axios",
      "lodash",
      "moment"
    ]
  }
}
