{
  "id": "website",
  "name": "AI Website Builder",
  "description": "Build and deploy full-stack websites with database, forms, and optional payments.",
  "scope": {
    "allowed": [
      "landing",
      "multi-page",
      "portfolio",
      "dashboard",
      "forms",
      "ecommerce-front",
      "blog"
    ],
    "forbidden": [
      "backend-api",
      "websocket-chat",
      "video-streaming",
      "rbac-admin",
      "payment-backend",
      "crypto",
      "p2p"
    ]
  },
  "stack": {
    "framework": "nextjs-14",
    "styling": "tailwind",
    "components": "shadcn",
    "icons": "lucide-react",
    "animation": "css"
  },
  "constraints": {
    "maxSectionsPerPage": 10,
    "maxFormsPerPage": 5,
    "maxPagesMVP": 1,
    "maxPagesV1": 5,
    "maxComponentsTotal": 20,
    "allowInlineStyles": false,
    "allowClientEnv": false,
    "allowDangerousHtml": false,
    "allowEval": false,
    "requiredComponentExports": [
      "default"
    ],
    "componentStyle": "functional",
    "typescriptStrict": true,
    "mobileFirst": true,
    "accessibilityRequired": true,
    "allowedDependencies": [
      "react",
      "react-dom",
      "next",
      "lucide-react",
      "@supabase/supabase-js"
    ],
    "forbiddenDependencies": [
      "jquery",
      "axios",
      "lodash",
      "moment",
      "styled-components",
      "@emotion/react",
      "gsap"
    ]
  }
}
