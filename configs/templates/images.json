{
  "id": "images",
  "name": "AI Images",
  "description": "Generate, edit, remove backgrounds, and upscale images.",
  "scope": {
    "allowed": [
      "text-to-image",
      "batch",
      "background-removal",
      "upscale",
      "region-edit"
    ],
    "forbidden": [
      "nsfw",
      "deepfake",
      "face-swap-without-consent",
      "bulk-web-scraping"
    ]
  },
  "stack": {
    "framework": "nextjs-14",
    "styling": "tailwind",
    "components": "shadcn",
    "icons": "lucide-react"
  },
  "constraints": {
    "maxImageSize": 2048,
    "maxImagesPerBatch": 4,
    "allowedFormats": [
      "png",
      "jpeg",
      "webp"
    ],
    "allowInlineStyles": false,
    "allowClientEnv": false,
    "componentStyle": "functional",
    "typescriptStrict": true,
    "allowedDependencies": [
      "react",
      "react-dom",
      "next",
      "lucide-react",
      "@supabase/supabase-js"
    ],
    "forbiddenDependencies": [
      "jquery",
      "axios",
      "lodash",
      "moment"
    ]
  }
}
