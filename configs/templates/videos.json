{
  "id": "videos",
  "name": "AI Videos",
  "description": "Generate and edit short videos from text or images with motion control.",
  "version": "1.0.0",
  "category": "create",
  "icon": "Video",
  "order": 4,

  "scope": {
    "allowed": [
      "text-to-video",
      "image-to-video",
      "background-removal",
      "motion-control",
      "timeline"
    ],
    "forbidden": [
      "live-streaming",
      "long-form-video",
      "complex-video-editor",
      "bulk-processing"
    ]
  },

  "stack": {
    "framework": "nextjs-14",
    "styling": "tailwind",
    "components": "shadcn",
    "state": "zustand",
    "videoPlayer": "html5-video",
    "videoApi": ["replicate", "huggingface"],
    "icons": "lucide-react"
  },

  "constraints": {
    "maxDurationSeconds": 60,
    "maxDurationMVP": 10,
    "maxResolution": "1080p",
    "allowedFormats": ["mp4", "webm"],
    "maxClipsInTimeline": 4,
    "allowInlineStyles": false,
    "allowClientEnv": false,
    "componentStyle": "functional",
    "typescriptStrict": true,
    "allowedDependencies": [
      "react",
      "react-dom",
      "next",
      "lucide-react",
      "zustand",
      "tailwindcss"
    ],
    "forbiddenDependencies": ["jquery", "axios", "lodash", "moment", "ffmpeg"]
  },

  "components": ["VideoGenerator", "VideoPlayer", "Timeline", "VideoExporter"],

  "formConstraints": {},

  "generation": {
    "stages": ["intent", "component", "validate"],
    "planModeRequiredFor": [],
    "askClarifyingQuestions": false,
    "showPlanBeforeBuild": false,
    "parallelComponentGeneration": false,
    "maxRetriesPerComponent": 2
  },

  "validation": {
    "autoTest": ["typecheck", "eslint", "ast-scan"],
    "staticAnalysisRules": [
      "maxDuration",
      "noClientApiKey",
      "hasVideoControls",
      "noForbiddenImports",
      "noUnusedImports"
    ],
    "buildCommands": ["tsc --noEmit"]
  },

  "model": {
    "intentModel": "openrouter:deepseek/deepseek-chat",
    "codeModel": "huggingface:deepseek-coder-7b",
    "fallback": [
      "openrouter:deepseek/deepseek-chat",
      "openrouter:Qwen/Qwen2.5-Coder"
    ]
  },

  "export": {
    "formats": ["zip"],
    "includeDatabaseSchema": false,
    "includeReadme": true,
    "includeEnvExample": true
  },

  "ui": {
    "defaultPrompt": "Create a 10-second product teaser from these three photos",
    "examplePrompts": [
      "15-second product teaser from three photos",
      "Animate between these two product shots",
      "Remove background in this video clip",
      "Create a cinematic intro for a podcast"
    ]
  }
}
