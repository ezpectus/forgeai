{
  "id": "videos",
  "name": "AI Videos",
  "description": "Generate and edit short videos from text or images with motion control.",
  "scope": {
    "allowed": [
      "text-to-video",
      "image-to-video",
      "background-removal",
      "motion-control",
      "timeline"
    ],
    "forbidden": [
      "live-streaming",
      "long-form-video",
      "complex-video-editor",
      "bulk-processing"
    ]
  },
  "stack": {
    "framework": "nextjs-14",
    "styling": "tailwind",
    "components": "shadcn",
    "icons": "lucide-react"
  },
  "constraints": {
    "maxDurationSeconds": 60,
    "maxDurationMVP": 10,
    "maxResolution": "1080p",
    "allowedFormats": [
      "mp4",
      "webm"
    ],
    "maxClipsInTimeline": 4,
    "allowInlineStyles": false,
    "allowClientEnv": false,
    "componentStyle": "functional",
    "typescriptStrict": true,
    "allowedDependencies": [
      "react",
      "react-dom",
      "next",
      "lucide-react",
      "@supabase/supabase-js"
    ],
    "forbiddenDependencies": [
      "jquery",
      "axios",
      "lodash",
      "moment",
      "ffmpeg"
    ]
  }
}
