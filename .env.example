# ForgeAI Environment Variables
# Copy this file to .env and fill in your keys
# Get keys from the links below

# === Required ===

# OpenRouter API Key
# Get one: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# === Optional (but recommended) ===

# HuggingFace Token (for cheaper code generation)
# Get one: https://hf.co/settings/tokens
HUGGINGFACE_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Gemini API Key (free tier available)
# Get one: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Supabase (for database features: forms, auth, storage)
# Get one: https://supabase.com
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_KEY=sb_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Vercel (for deployment to live URL)
# Get one: https://vercel.com/account/tokens
VERCEL_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# === Advanced (optional) ===

# E2B Sandbox (alternative deploy provider)
# Get one: https://e2b.dev
E2B_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Replicate (for image/video generation)
# Get one: https://replicate.com
REPLICATE_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ElevenLabs (for audio/TTS features)
# Get one: https://elevenlabs.io
ELEVENLABS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Tavily (for web search in reports)
# Get one: https://tavily.com
TAVILY_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# === Server Settings ===

# Port (default 3000)
PORT=3000

# API server URL and port used by Next.js rewrites and Hono orchestrator
# Run `npm run api` on this port, `npm run dev` on PORT
API_URL=http://localhost:3001
API_PORT=3001

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,https://forgeai.dev

# Rate limiting (requests per minute per IP)
RATE_LIMIT_RPM=10
