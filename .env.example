# ForgeAI Environment Variables
# Copy this file to .env and fill in your keys

# ForgeAI is BYOK — provider keys (OpenRouter, Gemini, HuggingFace, Supabase,
# Vercel) are entered in the app's Settings dialog and stored in the browser's
# IndexedDB. They are sent per-request and are NOT read from this file.
# Everything below configures the server processes themselves.

# === Server Settings ===

# Port for the Next.js frontend (default 3000)
PORT=3000

# API server URL and port used by Next.js rewrites and the Hono orchestrator
# Run `npm run api` on this port, `npm run dev` on PORT
API_URL=http://localhost:3001
API_PORT=3001

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,https://forgeai.dev

# Set to `development` for local dev (rate limiting defaults to 0).
# Set to `production` and configure RATE_LIMIT_RPM for live deployments.
NODE_ENV=development

# Rate limiting (requests per minute per IP). Only enforced when NODE_ENV=production.
# Defaults to 10 in production. Leave unset in dev to disable throttling.
RATE_LIMIT_RPM=10

# Trust X-Forwarded-For for rate-limit keys. Set only when the API sits behind
# a reverse proxy that sets the header — otherwise clients can spoof it.
TRUST_PROXY=false

# Send Strict-Transport-Security (HTTPS deployments only)
FORCE_HSTS=false

# Allow POST /api/templates to write user templates to the server filesystem.
# Only enable on self-hosted/long-lived deployments — on serverless/read-only
# hosts submissions would silently vanish.
ALLOW_TEMPLATE_SUBMISSIONS=false

# === Optional ===

# Attribution headers sent to OpenRouter (shows your app in their rankings)
OPENROUTER_REFERER=http://localhost:3000
OPENROUTER_TITLE=ForgeAI

# Public URL of THIS ForgeAI instance (used as a default where needed)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
