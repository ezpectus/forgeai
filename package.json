{
  "name": "forgeai",
  "version": "1.1.0",
  "description": "Open-source prompt-to-live-URL generator. BYOK, self-hostable, MIT licensed.",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ezpectus/forgeai.git"
  },
  "keywords": [
    "ai",
    "ai-agent",
    "prompt-to-website",
    "code-generation",
    "nextjs",
    "react",
    "tailwindcss",
    "shadcn-ui",
    "open-source",
    "byok",
    "self-hosted",
    "supabase",
    "openrouter",
    "huggingface",
    "deepseek",
    "text-to-code",
    "low-code",
    "no-code",
    "website-builder",
    "template-engine",
    "config-driven",
    "plugin-architecture",
    "vercel",
    "e2b",
    "typescript"
  ],
  "author": "ForgeAI Contributors",
  "bugs": {
    "url": "https://github.com/ezpectus/forgeai/issues"
  },
  "homepage": "https://github.com/ezpectus/forgeai",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "security": "node scripts/security-scan.mjs",
    "validate": "npm run lint && npm run typecheck && npm run security && npm run test && npm run build",
    "api": "tsx api/main.ts",
    "api:dev": "tsx watch api/main.ts",
    "lighthouse": "lighthouse http://localhost:3000 --view"
  },
  "dependencies": {
    "@hono/node-server": "^1.12.0",
    "@supabase/supabase-js": "^2.45.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "esbuild": "^0.25.0",
    "hono": "^4.5.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.439.0",
    "next": "16.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.46.0",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.4",
    "lighthouse": "^13.4.1",
    "postcss": "^8.5.23",
    "prettier": "^3.3.0",
    "tailwindcss": "^3.4.10",
    "tsx": "^4.17.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.23"
    },
    "@next/eslint-plugin-next": {
      "glob": "^10.5.0"
    },
    "vitest": {
      "vite": "^6.4.3"
    }
  },
  "engines": {
    "node": ">=18.18.0",
    "npm": ">=9.0.0"
  }
