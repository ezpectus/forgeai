{
  "id": "social-media-report",
  "name": "Social Media Report",
  "description": "A social media report report template.",
  "scope": {
    "allowed": [
      "landing",
      "hero",
      "features",
      "pricing",
      "contact-form",
      "footer"
    ],
    "forbidden": [
      "navbar",
      "sidebar",
      "mega-menu",
      "search",
      "cart"
    ]
  },
  "stack": {
    "framework": "nextjs",
    "styling": "tailwindcss",
    "components": "shadcn/ui",
    "icons": "lucide-react",
    "state": "zustand"
  },
  "constraints": {
    "allowedDependencies": [
      "react",
      "next",
      "lucide-react",
      "zustand",
      "@supabase/supabase-js"
    ],
    "forbiddenDependencies": [
      "jquery",
      "lodash",
      "moment",
      "axios"
    ],
    "maxComponents": 6,
    "maxLengthPerComponent": 500
  }
}
