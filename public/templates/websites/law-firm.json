{
  "scope": {
    "allowed": [
      "landing",
      "hero",
      "features",
      "pricing",
      "contact-form",
      "footer"
    ],
    "forbidden": [
      "navbar",
      "sidebar",
      "mega-menu",
      "search",
      "cart"
    ]
  },
  "stack": {
    "framework": "nextjs",
    "styling": "tailwindcss",
    "components": "shadcn/ui",
    "icons": "lucide-react",
    "state": "zustand"
  },
  "constraints": {
    "allowedDependencies": [
      "react",
      "next",
      "lucide-react",
      "zustand",
      "@supabase/supabase-js"
    ],
    "forbiddenDependencies": [
      "jquery",
      "lodash",
      "moment",
      "axios"
    ],
    "maxComponents": 6,
    "maxLengthPerComponent": 500
  },
  "components": [
    "Hero",
    "Features",
    "Pricing",
    "ContactForm",
    "Footer"
  ],
  "generation": {
    "stages": [
      "intent",
      "components",
      "validate",
      "assemble"
    ],
    "askClarifyingQuestions": false,
    "showPlanBeforeBuild": false,
    "parallelComponentGeneration": true,
    "maxRetriesPerComponent": 2
  },
  "validation": {
    "autoTest": [
      "render",
      "build"
    ],
    "staticAnalysisRules": [
      "syntax",
      "hasDefaultExport",
      "noDangerousHtml",
      "noEval",
      "usesTailwindOnly",
      "imagesHaveAlt",
      "formsHaveNames",
      "noForbiddenImports"
    ],
    "buildCommands": [
      "npm run build"
    ]
  },
  "model": {
    "intentModel": "openrouter/deepseek-v3",
    "codeModel": "huggingface/deepseek-coder",
    "fallback": [
      "openrouter/qwen-coder",
      "openrouter/llama-3.1-405b"
    ]
  },
  "export": {
    "formats": [
      "zip",
      "vercel",
      "e2b"
    ],
    "includeDatabaseSchema": true,
    "includeReadme": true,
    "includeEnvExample": true
  },
  "ui": {
    "defaultPrompt": "Create a law firm website with modern design and clear sections",
    "examplePrompts": [
      "A law firm with testimonials and a contact form"
    ]
  },
  "id": "law-firm",
  "name": "Law Firm",
  "description": "A law firm website template."
}